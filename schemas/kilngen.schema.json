            "type": "string",
            "pattern": "^K\\d{4}$"
          }
        },
        "error": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^K\\d{4}$"
          }
        },
        "warn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^K\\d{4}$"
          }
        }
      },
      "additionalProperties": false
    }
