              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "binary": {
              "type": "string"
            },
            "module": {
              "type": "string"
            }
          },
          "required": [
            "binary",
            "module"
          ],
          "additionalProperties": false
        },
        "terraform": {
          "type": "object",
          "properties": {
            "output": {
              "type": "string"
            },
            "edition": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "options": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "provider": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*$"
            },
