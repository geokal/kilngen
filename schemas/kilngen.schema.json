                  "enum": [
                    "patch",
                    "put"
                  ]
                },
                "sensitive": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "mcp": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
