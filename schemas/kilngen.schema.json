            },
            "options": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "module": {
              "type": "string"
            }
          },
          "required": [
            "module"
          ],
          "additionalProperties": false
        },
        "python": {
          "type": "object",
          "properties": {
            "output": {
              "type": "string"
            },
            "edition": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "options": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "package": {
              "type": "string"
            }
          },
          "required": [
            "package"
          ],
          "additionalProperties": false
        },
        "mcp": {
          "type": "object",
          "properties": {
            "output": {
              "type": "string"
            },
            "edition": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "options": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
