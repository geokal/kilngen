  "required": [
    "version",
    "edition",
    "project"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#\\/components\\/schemas\\/[^/]+$"
          }
        },
        "methods": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(get|put|post|delete|options|head|patch|trace)\\s+\\/\\S*$"
              },
              {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "type": "string",
                    "pattern": "^(get|put|post|delete|options|head|patch|trace)\\s+\\/\\S*$"
                  },
                  "paginated": {
                    "type": "boolean"
                  },
                  "pagination": {
                    "type": "string"
                  },
                  "stream": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "when_param": {
