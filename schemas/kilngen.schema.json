                "required": [
                  "scheme"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "retries": {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "backoff": {
              "type": "string",
              "enum": [
                "exponential",
                "constant"
              ]
            },
            "initial_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "max_ms": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "retry_on": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  {
                    "type": "string",
                    "pattern": "^([1-5]\\d\\d|[1-5]xx)$"
                  }
                ]
              }
            }
          },
          "required": [
            "max"
          ],
          "additionalProperties": false
        },
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency": {
          "type": "object",
          "properties": {
            "header": {
              "type": "string"
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "get",
                  "put",
                  "post",
                  "delete",
                  "options",
                  "head",
                  "patch",
                  "trace"
                ]
              }
            }
          },
          "required": [
            "header"
          ],
          "additionalProperties": false
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^([1-5]\\d\\d|[1-5]xx)$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "pagination": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "cursor",
              "cursor_from_item",
              "next_url",
              "offset",
              "page_number"
            ]
          },
          "request": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "param": {
                  "type": "string"
                },
                "in": {
                  "type": "string",
