              "required": [
                "param"
              ],
              "additionalProperties": false
            }
          },
          "response": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "from_last_item": {
