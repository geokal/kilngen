                  "unwrap": {
                    "type": "string"
                  },
                  "idempotent": {
                    "type": "boolean"
                  },
                  "deprecated": {
                    "type": [
                      "boolean",
                      "string"
                    ]
                  },
                  "positional_params": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "body_param_name": {
                    "type": "string"
                  },
                  "response": {
                    "type": "string",
                    "enum": [
                      "json",
                      "binary",
                      "text"
                    ]
                  },
                  "skip": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "typescript",
                            "go",
                            "python",
                            "mcp",
                            "cli",
                            "terraform",
                            "docs"
                          ]
                        }
                      }
                    ]
                  },
                  "docs": {
                    "type": "object",
                    "properties": {
                      "summary": {
                        "type": "string"
                      },
                      "examples": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "endpoint"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "subresources": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "skip": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "typescript",
                  "go",
                  "python",
                  "mcp",
                  "cli",
                  "terraform",
                  "docs"
                ]
              }
            }
          ]
        },
        "terraform": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
